# ==============================================================
# Pixvarse Portfolio & Digital Agency — Environment Configuration
# ==============================================================

# Public Site URL (Used for Canonical URLs, Open Graph, Sitemap & Robots)
# In production on Hostinger, set this to your custom domain:
NEXT_PUBLIC_SITE_URL=https://pixvarse.com

# Contact Form Delivery Configuration (Optional)
# If left unset, the contact form utilizes the zero-dependency mailto fallback.
# NEXT_PUBLIC_CONTACT_EMAIL=juelrahman09@gmail.com

# Node Environment (automatically handled by Hostinger Web App)
NODE_ENV=production

